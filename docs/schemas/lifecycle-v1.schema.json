{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcbcraft:schema:lifecycle:1",
  "title": "Native publisher lifecycle assertion or project/64 lifecycle document",
  "oneOf": [{"$ref": "#/$defs/assertion"}, {"$ref": "#/$defs/assessments"}],
  "$defs": {
    "nativeId": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?![\\s\\S])"},
    "stateId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?![\\s\\S])"},
    "singleLineText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\ufeff\\x00-\\x1f\\x7f-\\x9f](?:[^\\x00-\\x1f\\x7f-\\x9f]*[^\\s\ufeff\\x00-\\x1f\\x7f-\\x9f])?(?![\\s\\S])"
    },
    "revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "id", "revision"],
      "properties": {
        "library": {"$ref": "#/$defs/nativeId"},
        "id": {"$ref": "#/$defs/nativeId"},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "kind", "id", "revision"],
      "properties": {
        "library": {"$ref": "#/$defs/nativeId"},
        "kind": {"enum": ["symbol", "footprint", "category", "part", "manufacturer_part"]},
        "id": {"$ref": "#/$defs/nativeId"},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "address", "target", "scheme", "state", "reason", "provenance"],
      "properties": {
        "format": {"const": "pcbcraft-lifecycle-assertion/1"},
        "address": {"$ref": "#/$defs/reference"},
        "target": {"$ref": "#/$defs/target"},
        "scheme": {"$ref": "#/$defs/reference"},
        "state": {"$ref": "#/$defs/stateId"},
        "reason": {"$ref": "#/$defs/singleLineText", "maxLength": 4096},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisher"],
          "properties": {"publisher": {"$ref": "#/$defs/singleLineText", "maxLength": 256}}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "states"],
      "properties": {
        "scheme": {"$ref": "#/$defs/reference"},
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "disposition"],
            "properties": {
              "id": {"$ref": "#/$defs/stateId"},
              "label": {"$ref": "#/$defs/singleLineText", "maxLength": 256},
              "disposition": {"enum": ["draft", "released", "deprecated", "obsolete"]}
            }
          }
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertions", "policies"],
      "properties": {
        "assertions": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/assertion"}},
        "policies": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/policy"}}
      }
    }
  }
}
