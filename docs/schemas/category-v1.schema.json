{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcbcraft:schema:category:1",
  "title": "PCBcraft category definition, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "library",
    "id",
    "revision",
    "name",
    "license",
    "fields"
  ],
  "properties": {
    "format": {
      "const": "pcbcraft-category/1"
    },
    "library": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/id"
    },
    "id": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/id"
    },
    "revision": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/revision"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/field_id"
      },
      "additionalProperties": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/field"
      }
    }
  }
}
