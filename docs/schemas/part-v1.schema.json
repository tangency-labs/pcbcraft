{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcbcraft:schema:part:1",
  "title": "PCBcraft reusable part definition, format 1",
  "description": "A part definition references drawings and package options. Placed part instances and manufacturer/MPN records are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "library",
    "id",
    "revision",
    "name",
    "license",
    "source",
    "symbol",
    "packages"
  ],
  "properties": {
    "format": {
      "const": "pcbcraft-part/1"
    },
    "library": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/id"
    },
    "id": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/id"
    },
    "revision": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/revision"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*(?![\\s\\S])"
    },
    "source": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/source"
    },
    "symbol": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/reference"
    },
    "category": {
      "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/category_binding"
    },
    "fixed_parameters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/field_id"
      },
      "additionalProperties": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/parameter_value"
      }
    },
    "packages": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "urn:pcbcraft:schema:library-common:1#/$defs/package"
      }
    }
  },
  "dependentRequired": {
    "fixed_parameters": [
      "category"
    ]
  }
}
