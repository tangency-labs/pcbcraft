# Working project documents are text. Portable archives are binary exports.
*.json text eol=lf
*.pc binary

# Original command-generated performance fixtures and raw timing evidence.
tools/performance/fixtures/*.json linguist-generated=true
tools/performance/baselines/native-*.json linguist-generated=true
tools/performance/baselines/browser-*.json linguist-generated=true

# Retained evidence is checked against recorded SHA-256 digests, so its text logs keep exact
# bytes: no CRLF conversion on Windows checkouts with core.autocrlf. A checkout made before
# these rules shows its CRLF copies as modified; restore them with
# `git checkout -- tools/performance/baselines/extended`. Preserve any local edits first;
# this command overwrites tracked changes.
tools/performance/baselines/extended/*.log -text
tools/performance/baselines/extended/*.txt -text
# Membership-history evidence includes hashes of its runner and metadata as well as raw samples.
tools/performance/baselines/part-groups/** -text
